{
  "properties": {
    "activities": [
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "RunID",
          "value": "@pipeline().RunId"
        },
        "policy": {
          "secureOutput": false,
          "secureInput": false
        },
        "name": "Init RunID",
        "dependsOn": []
      },
      {
        "type": "Until",
        "typeProperties": {
          "expression": {
            "value": "@equals(variables('Done'), true)",
            "type": "Expression"
          },
          "activities": [
            {
              "type": "Lookup",
              "typeProperties": {
                "source": {
                  "type": "FabricSqlDatabaseSource",
                  "sqlReaderStoredProcedureName": "orch.spGetNextWave",
                  "storedProcedureParameters": {
                    "JobName": {
                      "type": "String",
                      "value": "@pipeline().parameters.JobName"
                    },
                    "RunID": {
                      "type": "String",
                      "value": "@variables('RunID')"
                    }
                  },
                  "queryTimeout": "02:00:00",
                  "partitionOption": "None"
                },
                "datasetSettings": {
                  "annotations": [],
                  "connectionSettings": {
                    "name": "db_Metadata",
                    "properties": {
                      "annotations": [],
                      "type": "FabricSqlDatabase",
                      "typeProperties": {
                        "workspaceId": "a937b42f-1407-41c9-b5bf-33288dc7f60f",
                        "artifactId": "15a01d6c-0d70-4a2d-b4da-28b809849709"
                      },
                      "externalReferences": {
                        "connection": "a6f55cb9-f9a5-4f45-89e6-7d93abc328b8"
                      }
                    }
                  },
                  "type": "FabricSqlDatabaseTable",
                  "schema": []
                }
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "name": "Get Next Wave",
              "dependsOn": []
            },
            {
              "type": "IfCondition",
              "typeProperties": {
                "expression": {
                  "value": "@greater(activity('Get Next Wave').output.firstRow.TaskCount, 0)",
                  "type": "Expression"
                },
                "ifTrueActivities": [
                  {
                    "type": "Switch",
                    "typeProperties": {
                      "on": {
                        "value": "@activity('Get Next Wave').output.firstRow.ExecutionMode",
                        "type": "Expression"
                      },
                      "cases": [
                        {
                          "value": "Sequential",
                          "activities": [
                            {
                              "type": "ExecutePipeline",
                              "typeProperties": {
                                "pipeline": {
                                  "referenceName": "580d4031-5dd6-b5b3-4ea5-65dff943135f",
                                  "type": "PipelineReference"
                                },
                                "waitOnCompletion": true,
                                "parameters": {
                                  "JobName": "@pipeline().parameters.JobName",
                                  "RunID": "@variables('RunID')",
                                  "TasksJson": "@activity('Get Next Wave').output.firstRow.TasksJson"
                                }
                              },
                              "policy": {
                                "secureInput": false
                              },
                              "name": "Run Sequential Wave",
                              "dependsOn": []
                            }
                          ]
                        },
                        {
                          "value": "Parallel",
                          "activities": [
                            {
                              "type": "ExecutePipeline",
                              "typeProperties": {
                                "pipeline": {
                                  "referenceName": "2449b1cd-db87-a77f-488e-53cae6b4f5e7",
                                  "type": "PipelineReference"
                                },
                                "waitOnCompletion": true,
                                "parameters": {
                                  "JobName": "@pipeline().parameters.JobName",
                                  "RunID": "@variables('RunID')",
                                  "TasksJson": "@activity('Get Next Wave').output.firstRow.TasksJson"
                                }
                              },
                              "policy": {
                                "secureInput": false
                              },
                              "name": "Run Parallel Wave",
                              "dependsOn": []
                            }
                          ]
                        }
                      ],
                      "defaultActivities": []
                    },
                    "name": "Switch On Execution Mode",
                    "dependsOn": []
                  }
                ]
              },
              "name": "Any Tasks Ready?",
              "dependsOn": [
                {
                  "activity": "Get Next Wave",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ]
            },
            {
              "type": "Lookup",
              "typeProperties": {
                "source": {
                  "type": "FabricSqlDatabaseSource",
                  "sqlReaderStoredProcedureName": "orch.spGetRunStatus",
                  "storedProcedureParameters": {
                    "JobName": {
                      "type": "String",
                      "value": "@pipeline().parameters.JobName"
                    },
                    "RunID": {
                      "type": "String",
                      "value": "@variables('RunID')"
                    }
                  },
                  "queryTimeout": "02:00:00",
                  "partitionOption": "None"
                },
                "datasetSettings": {
                  "annotations": [],
                  "connectionSettings": {
                    "name": "db_Metadata",
                    "properties": {
                      "annotations": [],
                      "type": "FabricSqlDatabase",
                      "typeProperties": {
                        "workspaceId": "a937b42f-1407-41c9-b5bf-33288dc7f60f",
                        "artifactId": "15a01d6c-0d70-4a2d-b4da-28b809849709"
                      },
                      "externalReferences": {
                        "connection": "a6f55cb9-f9a5-4f45-89e6-7d93abc328b8"
                      }
                    }
                  },
                  "type": "FabricSqlDatabaseTable",
                  "schema": []
                }
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "name": "Get Run Status",
              "dependsOn": [
                {
                  "activity": "Any Tasks Ready?",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ]
            },
            {
              "type": "SetVariable",
              "typeProperties": {
                "variableName": "Done",
                "value": "@or(equals(activity('Get Run Status').output.firstRow.RunStatus, 'Complete'), equals(activity('Get Run Status').output.firstRow.RunStatus, 'Failed'))"
              },
              "policy": {
                "secureOutput": false,
                "secureInput": false
              },
              "name": "Update Done",
              "dependsOn": [
                {
                  "activity": "Get Run Status",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ]
            }
          ],
          "timeout": "0.12:00:00"
        },
        "name": "Until All Tasks Done",
        "dependsOn": [
          {
            "activity": "Init RunID",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      }
    ],
    "parameters": {
      "JobName": {
        "type": "string"
      }
    },
    "variables": {
      "RunID": {
        "type": "String"
      },
      "Done": {
        "type": "Boolean"
      }
    }
  }
}
